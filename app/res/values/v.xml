<resources>
    <color name="navy">#043349</color>
    <color name="deep">#021B29</color>
    <color name="edge">#14506C</color>

    <style name="T" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:alertDialogTheme">@style/D</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:colorAccent">#FF803A</item>
        <item name="android:windowBackground">@color/deep</item>
        <item name="android:statusBarColor">@color/deep</item>
        <item name="android:navigationBarColor">#01131D</item>
    </style>

    <style name="D" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">#FF803A</item>
        <item name="android:windowBackground">@drawable/dialog</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="PopupMenu" parent="@android:style/Widget.DeviceDefault.PopupMenu">
        <item name="android:popupBackground">@drawable/menu</item>
    </style>
</resources>
