# Kotlin coding conventions (kotlinlang.org/docs/coding-conventions.html), checked by ktlint.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 160
ktlint_code_style = intellij_idea
